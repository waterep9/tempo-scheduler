# 数据库：SQLite 零依赖，PostgreSQL 用于多实例部署
DATABASE_URL=sqlite:///./tempo.db
# DATABASE_URL=postgresql+psycopg://tempo:tempo@localhost:5432/tempo

# 引导管理员密钥（首次启动写入 api_keys 表，之后可在控制台创建独立密钥）
TEMPO_BOOTSTRAP_TOKEN=tempo-admin-token

# 单进程演示时内嵌调度循环；多实例部署置 0 并单独启动 app.scheduler
TEMPO_EMBEDDED_PLANNER=1
TEMPO_PLANNER_INTERVAL=1.0
TEMPO_LEADER_TTL=10.0
TEMPO_TASK_LEASE_TTL=30.0
TEMPO_MAX_CATCH_UP=50
TEMPO_API_RATE_LIMIT=120
TEMPO_OUTPUT_LIMIT=8192
TEMPO_WORKER_OFFLINE_AFTER=30.0
